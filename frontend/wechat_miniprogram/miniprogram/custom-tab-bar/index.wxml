<view class="custom-tab-bar">
  <view
    class="tab-item {{selected === index ? 'is-active' : ''}}"
    wx:for="{{list}}"
    wx:key="pagePath"
    data-index="{{index}}"
    bindtap="switchTab"
  >
    <image class="tab-icon" src="{{item.iconPath}}" mode="aspectFit" />
    <text class="tab-label">{{item.text}}</text>
  </view>
</view>
