.states-page {
  padding: 24rpx;
}

.state-card {
  display: flex;
  align-items: flex-start;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.state-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 18rpx;
  background: #e6f0ff;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.state-icon-image {
  width: 34rpx;
  height: 34rpx;
  filter: brightness(0) saturate(100%) invert(39%) sepia(97%) saturate(2816%) hue-rotate(204deg) brightness(100%) contrast(104%);
}

.state-title {
  font-size: 30rpx;
  color: #1a1a1a;
  font-weight: 600;
}

.state-desc {
  margin-top: 8rpx;
  color: #666666;
  font-size: 26rpx;
  line-height: 1.6;
}

.no-evidence .state-icon,
.low-confidence .state-icon {
  background: #fff3e0;
}

.no-evidence .state-icon-image,
.low-confidence .state-icon-image {
  filter: brightness(0) saturate(100%) invert(62%) sepia(99%) saturate(1228%) hue-rotate(357deg) brightness(102%) contrast(96%);
}

.no-permission .state-icon,
.timeout .state-icon,
.blocked .state-icon {
  background: #fff0ef;
}

.no-permission .state-icon-image,
.timeout .state-icon-image,
.blocked .state-icon-image {
  filter: brightness(0) saturate(100%) invert(38%) sepia(85%) saturate(2339%) hue-rotate(337deg) brightness(100%) contrast(88%);
}
