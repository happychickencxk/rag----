<view class="page states-page">
  <view class="state-card card {{item.type}}" wx:for="{{statusCards}}" wx:key="type">
    <view class="state-icon">{{index + 1}}</view>
    <view>
      <view class="state-title">{{item.title}}</view>
      <view class="state-desc">{{item.desc}}</view>
    </view>
  </view>
</view>
