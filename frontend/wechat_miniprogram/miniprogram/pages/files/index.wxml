<custom-nav title="文件中心" back="{{true}}" />

<view class="page files-page">
  <!-- 当前知识库信息 -->
  <view class="kb-indicator">
    <text class="kb-label">目标知识库：</text>
    <text class="kb-value">{{selectedKbName || '未选择'}}</text>
    <text class="kb-change" catchtap="openKbPicker">切换</text>
  </view>

  <!-- 上传区域 -->
  <view class="upload-section {{canUpload ? '' : 'is-disabled'}}" bindtap="chooseFile">
    <view class="upload-visual">
      <image class="upload-visual-icon" src="/images/icons/upload-file.png" mode="aspectFit" />
    </view>
    <view class="upload-content">
      <view class="upload-title">上传知识文件</view>
      <view class="upload-meta">支持 PDF、DOCX、MD、TXT、HTML、CSV，单文件最大 20MB</view>
    </view>
    <button class="choose-button" disabled="{{!canUpload}}">{{canUpload ? "选择文件" : "无上传权限"}}</button>
  </view>

  <!-- 文件列表 -->
  <view class="file-section" wx:if="{{files.length}}">
    <view class="section-head">
      <text class="section-title">文件列表</text>
      <text class="section-count">{{files.length}} 个文件</text>
    </view>
    <view class="file-list">
      <view class="file-row" wx:for="{{files}}" wx:key="id">
        <view class="file-icon-box">
          <image class="file-icon" src="/images/icons/source.png" mode="aspectFit" />
        </view>
        <view class="file-info">
          <view class="file-name one-line">{{item.name}}</view>
          <view class="file-meta one-line">{{item.meta}}</view>
          <view class="file-error" wx:if="{{item.errorMsg}}">{{item.errorMsg}}</view>
        </view>
        <!-- 状态和操作 -->
        <view class="file-status-area">
          <text class="file-status status-{{item.status}}">{{item.statusText}}</text>
          <view wx:if="{{item.status === 'failed'}}" class="file-action-row">
            <text
              class="file-action-link retry-link"
              data-id="{{item.id}}"
              catchtap="retryUpload"
            >重试</text>
            <text
              class="file-action-link revoke-link"
              data-id="{{item.id}}"
              catchtap="removeFileTask"
            >撤销</text>
          </view>
          <text
            wx:elif="{{item.status === 'invalid'}}"
            class="file-action-link revoke-link"
            data-id="{{item.id}}"
            catchtap="removeFileTask"
          >撤销</text>
          <text
            wx:elif="{{item.status === 'success'}}"
            class="file-action-link download-link"
            data-id="{{item.id}}"
            catchtap="downloadFile"
          >下载</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty" wx:if="{{!files.length}}">
    <image class="empty-icon" src="/images/icons/upload-file.png" mode="aspectFit" />
    <text class="empty-text">暂无上传文件</text>
    <text class="empty-hint">点击上方区域选择文件上传到当前知识库</text>
  </view>

  <!-- 知识库选择弹层 -->
  <view wx:if="{{showKbPicker}}" class="sheet-mask" catchtap="closeKbPicker">
    <view class="kb-sheet" catchtap="noop">
      <view class="sheet-handle"></view>
      <view class="sheet-head">
        <text class="sheet-title">选择目标知识库</text>
      </view>
      <scroll-view class="sheet-list" scroll-y>
        <view
          class="sheet-kb-cell {{item.permission === 'denied' ? 'is-disabled' : ''}}"
          wx:for="{{knowledgeBases}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="selectKbForUpload"
        >
          <text class="sheet-kb-name one-line">{{item.name}}</text>
          <text class="sheet-permission-tag {{item.permission}}">{{item.permissionText}}</text>
        </view>
      </scroll-view>
    </view>
  </view>
</view>
