.files-page {
  min-height: 100vh;
  padding: 24rpx;
  background: #f7f8fa;
}

.upload-section {
  min-height: 156rpx;
  padding: 28rpx;
  border: 1rpx solid #ededed;
  border-radius: 16rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
}

.upload-visual {
  width: 76rpx;
  height: 76rpx;
  margin-right: 20rpx;
  border-radius: 18rpx;
  background: #e6f0ff;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 76rpx;
}

.upload-visual-icon {
  width: 40rpx;
  height: 40rpx;
  filter: brightness(0) saturate(100%) invert(39%) sepia(97%) saturate(2816%) hue-rotate(204deg) brightness(100%) contrast(104%);
}

.upload-content {
  flex: 1;
  min-width: 0;
}

.upload-title {
  color: #1a1a1a;
  font-size: 30rpx;
  font-weight: 700;
}

.upload-meta {
  margin-top: 10rpx;
  color: #888888;
  font-size: 22rpx;
  line-height: 1.45;
}

.choose-button {
  height: 64rpx;
  margin-left: 18rpx;
  padding: 0 20rpx;
  border-radius: 12rpx;
  background: #1677ff;
  color: #ffffff;
  font-size: 24rpx;
  line-height: 64rpx;
  text-align: center;
  flex: 0 0 auto;
  transition: background-color 200ms ease, opacity 200ms ease;
}

.file-section {
  margin-top: 24rpx;
  background: #ffffff;
  border-top: 1rpx solid #ededed;
  border-bottom: 1rpx solid #ededed;
}

.section-head {
  height: 84rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #ededed;
}

.section-title {
  color: #1a1a1a;
  font-size: 28rpx;
  font-weight: 700;
}

.section-count {
  color: #bdbdbd;
  font-size: 22rpx;
}

.file-row {
  width: 100%;
  min-height: 118rpx;
  padding: 22rpx 24rpx;
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid #ededed;
}

.file-row:last-child {
  border-bottom: 0;
}

.file-icon-box {
  width: 66rpx;
  height: 66rpx;
  margin-right: 18rpx;
  border-radius: 16rpx;
  background: #f4f8ff;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 66rpx;
}

.file-icon {
  width: 34rpx;
  height: 34rpx;
  filter: brightness(0) saturate(100%) invert(39%) sepia(97%) saturate(2816%) hue-rotate(204deg) brightness(100%) contrast(104%);
}

.file-info {
  flex: 1;
  min-width: 0;
}

.file-name {
  color: #1a1a1a;
  font-size: 27rpx;
  font-weight: 600;
}

.file-meta {
  margin-top: 10rpx;
  color: #888888;
  font-size: 22rpx;
}

.download-button {
  width: 104rpx;
  height: 56rpx;
  margin-left: 18rpx;
  border-radius: 12rpx;
  background: #f5f5f5;
  color: #bdbdbd;
  font-size: 22rpx;
  line-height: 56rpx;
  text-align: center;
  flex: 0 0 104rpx;
  transition: color 200ms ease, background-color 200ms ease;
}

.download-button.is-ready {
  color: #1677ff;
  background: #e6f0ff;
}
