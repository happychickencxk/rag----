.files-page {
  min-height: 100vh;
  padding: 24rpx;
  background: #f7f8fa;
}

/* 知识库指示 */
.kb-indicator {
  display: flex;
  align-items: center;
  padding: 18rpx 24rpx;
  margin-bottom: 20rpx;
  background: #ffffff;
  border-radius: 12rpx;
  border: 1rpx solid #ededed;
  font-size: 26rpx;
}

.kb-label {
  color: #888888;
}

.kb-value {
  color: #1a1a1a;
  font-weight: 600;
  margin: 0 12rpx;
}

.kb-change {
  margin-left: auto;
  color: #1677ff;
  font-size: 24rpx;
}

/* 上传区域 */
.upload-section {
  min-height: 156rpx;
  padding: 28rpx;
  border: 1rpx solid #ededed;
  border-radius: 16rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
}

.upload-section.is-disabled {
  opacity: 0.62;
}

.upload-visual {
  width: 76rpx;
  height: 76rpx;
  margin-right: 20rpx;
  border-radius: 18rpx;
  background: #e6f0ff;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 76rpx;
}

.upload-visual-icon {
  width: 40rpx;
  height: 40rpx;
  filter: brightness(0) saturate(100%) invert(39%) sepia(97%) saturate(2816%) hue-rotate(204deg) brightness(100%) contrast(104%);
}

.upload-content {
  flex: 1;
  min-width: 0;
}

.upload-title {
  color: #1a1a1a;
  font-size: 30rpx;
  font-weight: 700;
}

.upload-meta {
  margin-top: 10rpx;
  color: #888888;
  font-size: 22rpx;
  line-height: 1.45;
}

.choose-button {
  height: 64rpx;
  margin-left: 18rpx;
  padding: 0 20rpx;
  border-radius: 12rpx;
  background: #1677ff;
  color: #ffffff;
  font-size: 24rpx;
  line-height: 64rpx;
  text-align: center;
  flex: 0 0 auto;
}

/* 文件区域 */
.file-section {
  margin-top: 24rpx;
  background: #ffffff;
  border-top: 1rpx solid #ededed;
  border-bottom: 1rpx solid #ededed;
}

.section-head {
  height: 84rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #ededed;
}

.section-title {
  color: #1a1a1a;
  font-size: 28rpx;
  font-weight: 700;
}

.section-count {
  color: #bdbdbd;
  font-size: 22rpx;
}

.file-row {
  width: 100%;
  min-height: 118rpx;
  padding: 22rpx 24rpx;
  display: flex;
  align-items: flex-start;
  border-bottom: 1rpx solid #ededed;
}

.file-row:last-child {
  border-bottom: 0;
}

.file-icon-box {
  width: 66rpx;
  height: 66rpx;
  margin-right: 18rpx;
  border-radius: 16rpx;
  background: #f4f8ff;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 66rpx;
}

.file-icon {
  width: 34rpx;
  height: 34rpx;
  filter: brightness(0) saturate(100%) invert(39%) sepia(97%) saturate(2816%) hue-rotate(204deg) brightness(100%) contrast(104%);
}

.file-info {
  flex: 1;
  min-width: 0;
}

.file-name {
  color: #1a1a1a;
  font-size: 27rpx;
  font-weight: 600;
}

.file-meta {
  margin-top: 10rpx;
  color: #888888;
  font-size: 22rpx;
}

.file-error {
  margin-top: 8rpx;
  color: #ef4444;
  font-size: 22rpx;
}

/* 文件状态区域 */
.file-status-area {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  margin-left: 14rpx;
  gap: 8rpx;
}

.file-status {
  font-size: 22rpx;
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
}

.status-pending {
  color: #888888;
  background: #f5f5f5;
}

.status-uploading {
  color: #1677ff;
  background: #e6f0ff;
}

.status-success {
  color: #10b981;
  background: #ecfdf5;
}

.status-failed {
  color: #ef4444;
  background: #fff1f1;
}

.status-invalid {
  color: #ef4444;
  background: #fff1f1;
}

.file-action-link {
  font-size: 24rpx;
  font-weight: 600;
}

.file-action-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.retry-link {
  color: #1677ff;
}

.revoke-link {
  color: #ef4444;
}

.download-link {
  color: #1677ff;
}

/* 空状态 */
.empty {
  margin-top: 48rpx;
  padding: 80rpx 48rpx;
  text-align: center;
}

.empty-icon {
  width: 96rpx;
  height: 96rpx;
  margin-bottom: 24rpx;
  filter: brightness(0);
  opacity: 0.16;
}

.empty-text {
  color: #1a1a1a;
  font-size: 30rpx;
  font-weight: 700;
  display: block;
}

.empty-hint {
  margin-top: 12rpx;
  color: #888888;
  font-size: 26rpx;
  display: block;
}

/* KB 选择弹层 */
.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 999;
  background: rgba(0, 0, 0, 0.42);
  display: flex;
  align-items: flex-end;
}

.kb-sheet {
  width: 100%;
  max-height: 60vh;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  overflow: hidden;
}

.sheet-handle {
  width: 72rpx;
  height: 8rpx;
  margin: 22rpx auto 16rpx;
  border-radius: 8rpx;
  background: #ededed;
}

.sheet-head {
  height: 72rpx;
  padding: 0 44rpx;
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid #ededed;
}

.sheet-title {
  color: #1a1a1a;
  font-size: 34rpx;
  font-weight: 700;
}

.sheet-list {
  max-height: calc(60vh - 118rpx);
}

.sheet-kb-cell {
  width: 100%;
  box-sizing: border-box;
  min-height: 100rpx;
  padding: 26rpx 34rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #ededed;
}

.sheet-kb-cell.is-disabled {
  opacity: 0.45;
}

.sheet-kb-name {
  flex: 1;
  min-width: 0;
  color: #1a1a1a;
  font-size: 30rpx;
  font-weight: 600;
}

.sheet-permission-tag {
  margin-left: 16rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.sheet-permission-tag.granted {
  color: #10b981;
  background: #ecfdf5;
}

.sheet-permission-tag.denied {
  color: #ff7a7a;
  background: #fff1f1;
}
