page {
  background: #f7f8fa;
}

.knowledge-page {
  padding: 24rpx;
}

.search-box {
  background: #ffffff;
  border-radius: 18rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 22rpx;
}

.search-box input {
  font-size: 28rpx;
  color: #1a1a1a;
}

.kb-cell {
  width: 100%;
  padding: 26rpx 24rpx;
  margin-bottom: 18rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.kb-cell.disabled {
  opacity: 0.58;
}

.kb-left {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: flex-start;
}

.kb-mark {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  background: #e6f0ff;
  color: #1677ff;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.kb-mark.locked {
  background: #f5f5f5;
  color: #888888;
}

.kb-info {
  flex: 1;
  min-width: 0;
}

.kb-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.kb-title {
  font-size: 30rpx;
  color: #1a1a1a;
  font-weight: 600;
}

.selected {
  color: #1677ff;
  background: #e6f0ff;
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
}

.kb-desc {
  margin-top: 8rpx;
  font-size: 25rpx;
  line-height: 1.55;
  color: #666666;
}

.kb-meta {
  margin-top: 10rpx;
  color: #888888;
  font-size: 22rpx;
}

.permission {
  margin-left: 18rpx;
  font-size: 22rpx;
  flex-shrink: 0;
}

.permission.granted {
  color: #10b981;
}

.permission.denied {
  color: #ef4444;
}

.empty {
  padding: 48rpx 24rpx;
  text-align: center;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 600;
}

.empty-desc {
  color: #888888;
  font-size: 26rpx;
  margin-top: 10rpx;
}
