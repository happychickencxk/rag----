page {
  background: #f7f8fa;
}

.knowledge-page {
  min-height: 100vh;
  background: #f7f8fa;
}

.search-section {
  padding: 20rpx 38rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #ededed;
}

.search-box {
  height: 72rpx;
  padding: 0 24rpx;
  border-radius: 18rpx;
  background: #f5f5f5;
  display: flex;
  align-items: center;
}

.search-icon {
  width: 34rpx;
  margin-right: 12rpx;
  color: #bdbdbd;
  font-size: 34rpx;
  line-height: 1;
  flex: 0 0 34rpx;
}

.search-box input {
  flex: 1;
  min-width: 0;
  color: #1a1a1a;
  font-size: 28rpx;
}

.search-placeholder {
  color: #bdbdbd;
}

.kb-list {
  background: #ffffff;
}

.kb-cell {
  width: 100%;
  min-height: 136rpx;
  padding: 26rpx 38rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid #ededed;
}

.kb-cell.is-disabled {
  opacity: 0.48;
}

.kb-mark {
  width: 92rpx;
  height: 92rpx;
  margin-right: 24rpx;
  border-radius: 22rpx;
  background: #e6f0ff;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 92rpx;
}

.kb-mark.locked {
  background: #f5f5f5;
}

.book-icon {
  position: relative;
  width: 40rpx;
  height: 34rpx;
}

.book-page {
  position: absolute;
  top: 0;
  width: 18rpx;
  height: 32rpx;
  border: 4rpx solid #3478ff;
  border-radius: 4rpx;
}

.book-page.left {
  left: 0;
  border-right-width: 2rpx;
}

.book-page.right {
  right: 0;
  border-left-width: 2rpx;
}

.lock-icon {
  position: relative;
  width: 42rpx;
  height: 42rpx;
}

.lock-ring {
  position: absolute;
  left: 10rpx;
  top: 0;
  width: 22rpx;
  height: 22rpx;
  border: 4rpx solid #d6d6d6;
  border-bottom: 0;
  border-radius: 18rpx 18rpx 0 0;
}

.lock-body {
  position: absolute;
  left: 6rpx;
  bottom: 0;
  width: 30rpx;
  height: 26rpx;
  border: 4rpx solid #d6d6d6;
  border-radius: 5rpx;
}

.kb-info {
  flex: 1;
  min-width: 0;
}

.kb-title-row {
  display: flex;
  align-items: center;
  min-width: 0;
}

.kb-title {
  max-width: 260rpx;
  color: #1a1a1a;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.2;
}

.permission {
  margin-left: 14rpx;
  padding: 3rpx 12rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.25;
  flex: 0 0 auto;
}

.permission.granted {
  color: #10b981;
  background: #ecfdf5;
}

.permission.denied {
  color: #ff7a7a;
  background: #fff1f1;
}

.kb-desc {
  margin-top: 12rpx;
  color: #888888;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.25;
}

.kb-meta {
  margin-top: 10rpx;
  color: #bdbdbd;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.25;
}

.selected-mark,
.cell-arrow {
  width: 34rpx;
  margin-left: 18rpx;
  color: #3478ff;
  font-size: 40rpx;
  line-height: 1;
  text-align: right;
  flex: 0 0 34rpx;
}

.cell-arrow {
  color: #bdbdbd;
}

.empty {
  padding: 80rpx 24rpx;
  background: #ffffff;
  text-align: center;
}

.empty-title {
  color: #1a1a1a;
  font-size: 30rpx;
  font-weight: 700;
}

.empty-desc {
  margin-top: 10rpx;
  color: #888888;
  font-size: 26rpx;
}
