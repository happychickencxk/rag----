.knowledge-page {
  min-height: 100vh;
  padding-bottom: calc(100rpx + env(safe-area-inset-bottom));
  background: #f7f8fa;
}

.search-section {
  padding: 20rpx 38rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #ededed;
}

.search-box {
  height: 72rpx;
  padding: 0 24rpx;
  border-radius: 18rpx;
  background: #f5f5f5;
  display: flex;
  align-items: center;
}

.search-icon {
  width: 30rpx;
  height: 30rpx;
  margin-right: 12rpx;
  flex: 0 0 30rpx;
  filter: brightness(0);
  opacity: 0.26;
}

.search-input {
  flex: 1;
  min-width: 0;
  color: #1a1a1a;
  font-size: 28rpx;
}

.search-placeholder {
  color: #bdbdbd;
}

.kb-list {
  width: 100%;
  background: #ffffff;
}

.kb-cell {
  width: 100%;
  box-sizing: border-box;
  min-height: 136rpx;
  padding: 26rpx 38rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid #ededed;
}

.kb-cell.is-disabled {
  opacity: 0.48;
}

.kb-mark {
  width: 92rpx;
  height: 92rpx;
  margin-right: 24rpx;
  border-radius: 22rpx;
  background: #e6f0ff;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 92rpx;
}

.kb-mark.locked {
  background: #f5f5f5;
}

.kb-mark-image {
  width: 48rpx;
  height: 48rpx;
  filter: brightness(0) saturate(100%) invert(39%) sepia(97%) saturate(2816%) hue-rotate(204deg) brightness(100%) contrast(104%);
}

.kb-mark.locked .kb-mark-image {
  filter: brightness(0) saturate(100%) invert(38%) sepia(85%) saturate(2339%) hue-rotate(337deg) brightness(100%) contrast(88%);
}

.kb-info {
  flex: 1;
  min-width: 0;
}

.kb-title-row {
  display: flex;
  align-items: center;
  min-width: 0;
}

.kb-title {
  max-width: 260rpx;
  color: #1a1a1a;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.2;
}

.permission {
  margin-left: 14rpx;
  padding: 3rpx 12rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.25;
  flex: 0 0 auto;
}

.permission.granted {
  color: #10b981;
  background: #ecfdf5;
}

.permission.denied {
  color: #ff7a7a;
  background: #fff1f1;
}

.kb-desc {
  margin-top: 12rpx;
  color: #888888;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.25;
}

.kb-meta {
  margin-top: 10rpx;
  color: #bdbdbd;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.25;
}

.selected-mark,
.cell-arrow {
  width: 34rpx;
  margin-left: 18rpx;
  color: #3478ff;
  font-size: 40rpx;
  line-height: 1;
  text-align: right;
  flex: 0 0 34rpx;
}

.cell-arrow {
  color: #bdbdbd;
}

/* 通用状态区域 */
.state-box {
  padding: 120rpx 48rpx;
  background: #ffffff;
  text-align: center;
}

.state-icon {
  width: 96rpx;
  height: 96rpx;
  margin-bottom: 24rpx;
  filter: brightness(0);
  opacity: 0.16;
}

.state-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid #f0f0f0;
  border-top-color: #1677ff;
  border-radius: 50%;
  margin: 0 auto 20rpx;
  animation: state-spin 800ms linear infinite;
}

@keyframes state-spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.state-text {
  color: #888888;
  font-size: 26rpx;
}

.state-title {
  color: #1a1a1a;
  font-size: 30rpx;
  font-weight: 700;
}

.state-desc {
  margin-top: 12rpx;
  color: #888888;
  font-size: 26rpx;
  line-height: 1.5;
}

.state-retry {
  display: inline-block;
  margin-top: 24rpx;
  padding: 16rpx 40rpx;
  color: #1677ff;
  font-size: 28rpx;
  border: 2rpx solid #1677ff;
  border-radius: 12rpx;
}

.load-more {
  padding: 24rpx 0;
  text-align: center;
  background: #ffffff;
}

.load-more-text {
  color: #bdbdbd;
  font-size: 24rpx;
}

.load-more-action {
  color: #1677ff;
}
