<view class="knowledge-page">
  <view class="search-section">
    <view class="search-box">
      <text class="search-icon">⌕</text>
      <input value="{{keyword}}" placeholder="搜索知识库..." placeholder-class="search-placeholder" bindinput="onSearch" />
    </view>
  </view>

  <view class="empty" wx:if="{{!list.length}}">
    <view class="empty-title">暂无匹配知识库</view>
    <view class="empty-desc">请换一个关键词重新搜索。</view>
  </view>

  <view class="kb-list" wx:else>
    <button class="kb-cell {{item.permission === 'denied' ? 'is-disabled' : ''}}" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="selectKb">
      <view class="kb-mark {{item.permission === 'denied' ? 'locked' : ''}}">
        <view wx:if="{{item.permission !== 'denied'}}" class="book-icon">
          <view class="book-page left"></view>
          <view class="book-page right"></view>
        </view>
        <view wx:else class="lock-icon">
          <view class="lock-ring"></view>
          <view class="lock-body"></view>
        </view>
      </view>
      <view class="kb-info">
        <view class="kb-title-row">
          <text class="kb-title one-line">{{item.name}}</text>
          <text class="permission {{item.permission}}">{{item.permissionText}}</text>
        </view>
        <view class="kb-desc one-line">{{item.description}}</view>
        <view class="kb-meta one-line">{{item.department}} · {{item.docCount}} 份文档 · 更新于{{item.updatedAt}}</view>
      </view>
      <text class="selected-mark" wx:if="{{selectedKbId === item.id}}">✓</text>
      <text class="cell-arrow" wx:else>›</text>
    </button>
  </view>
</view>
