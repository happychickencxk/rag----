<custom-nav title="我的" />

<view class="page profile-page">
  <view class="user-card">
    <image class="avatar" src="/images/icons/avatar.png" mode="aspectFill" />
    <view>
      <view class="user-name">{{user.name}}</view>
      <view class="user-role" wx:if="{{user.department || user.role}}">{{user.department}}{{user.department && user.role ? ' · ' : ''}}{{user.role}}</view>
    </view>
    <view class="loading-hint" wx:if="{{loading}}">
      <text>加载中...</text>
    </view>
  </view>

  <!-- 统计数据：无接口时显示 "--" -->
  <view class="stats">
    <view class="stat-item">
      <view class="stat-value">{{stats.historyCount}}</view>
      <view class="stat-label">历史问答</view>
    </view>
    <view class="stat-item">
      <view class="stat-value">{{stats.feedbackCount}}</view>
      <view class="stat-label">反馈记录</view>
    </view>
    <view class="stat-item">
      <view class="stat-value">{{stats.commonKbCount}}</view>
      <view class="stat-label">常用知识库</view>
    </view>
  </view>

  <view class="section card" wx:if="{{knowledgeBases.length}}">
    <view class="section-title">我的知识库权限</view>
    <view class="permission-row" wx:for="{{knowledgeBases}}" wx:key="id">
      <text class="{{item.permission === 'denied' ? 'muted' : ''}}">{{item.name}}</text>
      <text class="permission {{item.permission}}">{{item.permissionText}}</text>
    </view>
  </view>

  <view class="section settings-section card">
    <view class="setting-cell" bindtap="handleClearHistory">
      <view class="setting-main">
        <image class="setting-icon" src="/images/icons/clear-history.png" mode="aspectFit" />
        <text>清空历史会话</text>
      </view>
      <text class="setting-arrow">›</text>
    </view>
    <view class="setting-cell" bindtap="handleNotification">
      <view class="setting-main">
        <image class="setting-icon" src="/images/icons/notification.png" mode="aspectFit" />
        <text>消息通知</text>
      </view>
      <text class="setting-arrow">›</text>
    </view>
    <view class="setting-cell warning-setting" bindtap="openStates">
      <view class="setting-main">
        <image class="setting-icon" src="/images/icons/warning-circle.png" mode="aspectFit" />
        <text>异常状态预览</text>
      </view>
      <text class="setting-arrow">›</text>
    </view>
    <view class="setting-cell" bindtap="handleAbout">
      <view class="setting-main">
        <image class="setting-icon" src="/images/icons/about.png" mode="aspectFit" />
        <text>关于系统</text>
      </view>
      <text class="setting-arrow">›</text>
    </view>
  </view>

  <button class="logout" bindtap="handleLogout">退出登录</button>
</view>
