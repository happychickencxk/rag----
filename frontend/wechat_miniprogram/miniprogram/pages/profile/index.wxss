.profile-page {
  padding-bottom: calc(148rpx + env(safe-area-inset-bottom));
}

.user-card {
  display: flex;
  align-items: center;
  padding: 40rpx 32rpx 34rpx;
  background: #ffffff;
}

.avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 56rpx;
  margin-right: 26rpx;
}

.user-name {
  font-size: 36rpx;
  color: #1a1a1a;
  font-weight: 700;
}

.user-role {
  margin-top: 12rpx;
  color: #888888;
  font-size: 26rpx;
}

.stats {
  display: flex;
  background: #ffffff;
  border-top: 1rpx solid #ededed;
  border-bottom: 1rpx solid #ededed;
}

.stat-item {
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
  border-right: 1rpx solid #ededed;
}

.stat-item:last-child {
  border-right: 0;
}

.stat-value {
  color: #1677ff;
  font-size: 40rpx;
  font-weight: 700;
}

.stat-label {
  margin-top: 8rpx;
  color: #888888;
  font-size: 22rpx;
}

.section {
  margin: 20rpx 24rpx 0;
  padding: 24rpx;
}

.section-title {
  font-size: 28rpx;
  color: #1a1a1a;
  font-weight: 600;
  margin-bottom: 18rpx;
}

.permission-row {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 0;
  font-size: 26rpx;
}

.muted {
  color: #bdbdbd;
}

.permission.granted {
  color: #10b981;
}

.permission.denied {
  color: #ef4444;
}

.setting-cell {
  width: 100%;
  padding: 24rpx 8rpx;
  border-bottom: 1rpx solid #ededed;
  font-size: 28rpx;
  color: #1a1a1a;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.settings-section {
  padding-left: 12rpx;
  padding-right: 12rpx;
}

.setting-cell:last-child {
  border-bottom: 0;
}

.setting-main {
  display: flex;
  align-items: center;
  min-width: 0;
}

.setting-icon {
  width: 38rpx;
  height: 38rpx;
  margin-right: 20rpx;
  flex: 0 0 38rpx;
  filter: brightness(0);
  opacity: 0.56;
  transition: filter 200ms ease, opacity 200ms ease;
}

.warning-setting .setting-icon {
  filter: brightness(0) saturate(100%) invert(62%) sepia(99%) saturate(1228%) hue-rotate(357deg) brightness(102%) contrast(96%);
  opacity: 1;
}

.setting-arrow {
  margin-left: 20rpx;
  color: #bdbdbd;
  font-size: 36rpx;
  line-height: 1;
  transition: color 200ms ease, transform 200ms ease;
}

.logout {
  margin: 36rpx 24rpx 0;
  width: calc(100% - 48rpx);
  height: 88rpx;
  border: 2rpx solid #ef4444;
  color: #ef4444;
  border-radius: 18rpx;
  text-align: center;
  line-height: 88rpx;
  font-size: 30rpx;
  font-weight: 600;
}
