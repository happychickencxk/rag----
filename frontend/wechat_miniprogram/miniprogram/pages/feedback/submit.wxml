<custom-nav title="提交反馈" back="{{true}}" />

<view class="page feedback-page" wx:if="{{!submitted}}">
  <view class="summary card">
    <view class="field">
      <view class="label">原问题</view>
      <view class="value">试用期请假是否影响转正？</view>
    </view>
    <view class="field border">
      <view class="label">AI 回答摘要</view>
      <view class="value muted">根据人事制度库的规定，试用期请假不会直接影响转正，但需注意累计天数及规范流程...</view>
    </view>
  </view>

  <view class="section card">
    <view class="section-title">反馈类型 <text class="required-mark">*</text></view>
    <view class="radio-row" wx:for="{{options}}" wx:key="*this" data-value="{{item}}" bindtap="selectType">
      <view class="radio {{selected === item ? 'checked' : ''}}"></view>
      <text class="radio-label {{selected === item ? 'active' : ''}}">{{item}}</text>
    </view>
  </view>

  <view class="section card">
    <view class="section-title">补充说明 <text class="optional">选填</text></view>
    <textarea class="note" value="{{note}}" maxlength="200" placeholder="请描述具体问题，帮助我们改善回答质量..." bindinput="onNoteInput"></textarea>
    <view class="counter">{{note.length}}/200</view>
  </view>

  <button class="submit {{hasNote ? 'enabled' : ''}}" bindtap="submit">提交反馈</button>
</view>

<view class="page success-page" wx:else>
  <view class="success-icon">✓</view>
  <view class="success-title">反馈已提交</view>
  <view class="success-desc">感谢你的反馈，知识库负责人将进行处理，持续改善回答质量。</view>
  <button class="back-btn" bindtap="back">返回</button>
</view>
