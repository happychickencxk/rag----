.feedback-page {
  padding: 24rpx;
}

.summary,
.section {
  padding: 28rpx;
  margin-bottom: 22rpx;
}

.field.border {
  border-top: 1rpx solid #ededed;
  margin-top: 20rpx;
  padding-top: 20rpx;
}

.label {
  color: #bdbdbd;
  font-size: 22rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.value {
  color: #1a1a1a;
  font-size: 28rpx;
  line-height: 1.65;
}

.muted {
  color: #666666;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 18rpx;
}

.required-mark {
  color: #ef4444;
}

.optional {
  color: #bdbdbd !important;
  font-size: 24rpx;
  font-weight: 400;
}

.radio-row {
  width: 100%;
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  font-size: 28rpx;
  color: #1a1a1a;
}

.radio {
  width: 36rpx;
  height: 36rpx;
  border: 3rpx solid #ededed;
  border-radius: 18rpx;
  margin-right: 20rpx;
}

.radio.checked {
  border-color: #1677ff;
  background: radial-gradient(circle, #ffffff 0 28%, #1677ff 30% 100%);
}

.active {
  color: #1677ff;
  font-weight: 600;
}

.note {
  width: 100%;
  min-height: 180rpx;
  background: #f5f5f5;
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 26rpx;
  line-height: 1.6;
}

.counter {
  text-align: right;
  color: #bdbdbd;
  font-size: 22rpx;
  margin-top: 8rpx;
}

.submit {
  width: 100%;
  height: 92rpx;
  border-radius: 18rpx;
  background: #c8c8c8;
  color: #ffffff;
  text-align: center;
  line-height: 92rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.submit.enabled {
  background: #1677ff;
}

.success-page {
  min-height: 80vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 48rpx;
}

.success-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 38rpx;
  background: #ecfdf5;
  color: #10b981;
  font-size: 64rpx;
  line-height: 120rpx;
  margin-bottom: 28rpx;
}

.success-title {
  font-size: 36rpx;
  font-weight: 700;
}

.success-desc {
  margin-top: 16rpx;
  color: #666666;
  line-height: 1.7;
  font-size: 28rpx;
}

.back-btn {
  margin-top: 48rpx;
  padding: 22rpx 56rpx;
  border-radius: 18rpx;
  background: #1677ff;
  color: #ffffff;
  font-size: 28rpx;
}
