<view class="chat-page">
  <button class="kb-strip" bindtap="openKnowledge">
    <view class="kb-left">
      <view class="kb-icon">
        <view class="book-line"></view>
        <view class="book-line short"></view>
      </view>
      <text class="kb-name">{{selectedKb.name}}</text>
      <text class="kb-status">已连接</text>
    </view>
    <view class="kb-right">
      <text>切换</text>
      <text class="chevron">⌄</text>
    </view>
  </button>

  <view class="conversation">
    <block wx:for="{{messages}}" wx:key="id">
      <view wx:if="{{item.role === 'user'}}" class="message-row user-row">
        <view class="user-bubble">{{item.text}}</view>
      </view>

      <view wx:if="{{item.role === 'assistant'}}" class="message-row ai-row">
        <view class="ai-avatar">✦</view>
        <view class="ai-card">
          <view class="low-confidence" wx:if="{{item.lowConfidence}}">回答置信度较低，请结合引用来源人工确认。</view>

          <view class="answer-content" wx:if="{{item.paragraphs}}">
            <view class="answer-paragraph" wx:for="{{item.paragraphs}}" wx:for-item="paragraph" wx:key="id">
              <text
                wx:for="{{paragraph.segments}}"
                wx:for-item="segment"
                wx:key="id"
                class="answer-segment {{segment.strong ? 'answer-strong' : ''}}"
              >{{segment.text}}</text>
            </view>
          </view>
          <text wx:else class="answer-text">{{item.text}}</text>

          <view class="citation-card" wx:if="{{item.citations.length}}">
            <button class="citation-header" bindtap="toggleCitations">
              <view class="citation-title">
                <text class="file-icon">▤</text>
                <text>查看来源</text>
                <text class="citation-count">{{item.citations.length}}</text>
              </view>
              <text class="citation-arrow">{{citationExpanded ? "⌃" : "⌄"}}</text>
            </button>
            <view wx:if="{{citationExpanded}}" class="citation-list">
              <button class="citation-item" wx:for="{{item.citations}}" wx:key="id" data-id="{{item.id}}" bindtap="openCitation">
                <view class="citation-index">{{index + 1}}</view>
                <view class="citation-body">
                  <view class="citation-line">
                    <text class="citation-name one-line">{{item.title}}</text>
                    <text class="score {{item.scoreLevel}}">{{item.rerankPercent}}</text>
                  </view>
                  <view class="citation-path one-line">{{item.path}}</view>
                  <view class="citation-excerpt two-line">{{item.excerpt}}</view>
                </view>
              </button>
            </view>
          </view>

          <view class="feedback-bar">
            <button class="feedback-btn {{feedbackValue === 'like' ? 'active' : ''}}" data-value="like" bindtap="markHelpful">
              <text class="feedback-icon">△</text>
              <text>有用</text>
            </button>
            <button class="feedback-btn {{feedbackValue === 'dislike' ? 'danger' : ''}}" data-value="dislike" bindtap="markHelpful">
              <text class="feedback-icon">▽</text>
              <text>没用</text>
            </button>
            <button class="feedback-btn" bindtap="copyAnswer">
              <text class="feedback-icon">▣</text>
              <text>复制</text>
            </button>
            <button class="feedback-btn" bindtap="regenerate">
              <text class="feedback-icon">↻</text>
              <text>重新生成</text>
            </button>
            <button class="feedback-btn" bindtap="submitFeedback">
              <text class="feedback-icon">⚐</text>
              <text>纠错</text>
            </button>
          </view>
        </view>
      </view>
    </block>
  </view>

  <view class="input-placeholder"></view>
  <view class="question-bar safe-bottom">
    <button class="voice-btn" bindtap="voiceInput" aria-label="语音输入">
      <view class="mic-icon">
        <view class="mic-head"></view>
        <view class="mic-stem"></view>
        <view class="mic-base"></view>
      </view>
    </button>
    <view class="input-shell">
      <textarea
        class="question-input"
        value="{{question}}"
        auto-height
        maxlength="300"
        placeholder="请输入你的问题..."
        placeholder-class="question-placeholder"
        bindinput="onInput"
      ></textarea>
    </view>
    <button class="send-btn {{question ? 'enabled' : ''}}" bindtap="onSend" aria-label="发送">
      <view class="send-plane"></view>
    </button>
  </view>

  <view wx:if="{{showKbSheet}}" class="sheet-mask" catchtap="closeKbSheet">
    <view class="kb-sheet safe-bottom" catchtap="noop">
      <view class="sheet-handle"></view>
      <view class="sheet-head">
        <text class="sheet-title">选择知识库</text>
        <button class="sheet-close" bindtap="closeKbSheet">×</button>
      </view>
      <scroll-view class="sheet-list" scroll-y>
        <button
          class="sheet-kb-cell {{item.permission === 'denied' ? 'is-disabled' : ''}}"
          wx:for="{{knowledgeBases}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="selectKbFromSheet"
        >
          <view class="sheet-kb-icon {{item.permission === 'denied' ? 'locked' : ''}}">
            <view wx:if="{{item.permission !== 'denied'}}" class="sheet-book">
              <view class="sheet-book-page left"></view>
              <view class="sheet-book-page right"></view>
            </view>
            <view wx:else class="sheet-lock">
              <view class="sheet-lock-ring"></view>
              <view class="sheet-lock-body"></view>
            </view>
          </view>
          <view class="sheet-kb-content">
            <view class="sheet-kb-title-row">
              <text class="sheet-kb-title one-line">{{item.name}}</text>
              <text class="sheet-permission {{item.permission}}">{{item.permissionText}}</text>
            </view>
            <view class="sheet-kb-desc one-line">{{item.description}}</view>
            <view class="sheet-kb-meta one-line">{{item.department}} · {{item.docCount}} 份文档 · 更新于{{item.updatedAt}}</view>
          </view>
          <text class="sheet-check" wx:if="{{selectedKb.id === item.id}}">✓</text>
          <text class="sheet-arrow" wx:else>›</text>
        </button>
      </scroll-view>
    </view>
  </view>
</view>
