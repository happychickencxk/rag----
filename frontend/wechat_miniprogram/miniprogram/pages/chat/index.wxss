page {
  background: #f7f8fa;
}

.chat-page {
  min-height: 100vh;
  background: #f7f8fa;
}

.kb-strip {
  width: 100%;
  box-sizing: border-box;
  height: 82rpx;
  padding: 0 32rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #ededed;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.kb-left,
.kb-right,
.citation-title,
.feedback-btn,
.voice-btn,
.send-btn {
  display: flex;
  align-items: center;
}

.kb-left {
  min-width: 0;
}

.kb-icon {
  width: 42rpx;
  height: 42rpx;
  border-radius: 12rpx;
  background: #e6f0ff;
  margin-right: 18rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 5rpx;
  flex-shrink: 0;
}

.book-line {
  width: 18rpx;
  height: 4rpx;
  border-radius: 4rpx;
  background: #1677ff;
}

.book-line.short {
  width: 12rpx;
}

.kb-name {
  max-width: 300rpx;
  color: #1a1a1a;
  font-size: 30rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.kb-status {
  margin-left: 16rpx;
  padding: 3rpx 10rpx;
  border-radius: 8rpx;
  background: #ecfdf5;
  color: #10b981;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.25;
  flex-shrink: 0;
}

.kb-right {
  gap: 8rpx;
  color: #888888;
  font-size: 26rpx;
  flex-shrink: 0;
}

.chevron {
  color: #888888;
  font-size: 28rpx;
  line-height: 1;
  transform: translateY(-2rpx);
}

.conversation {
  padding: 24rpx 28rpx 0;
}

.message-row {
  display: flex;
  margin-bottom: 26rpx;
}

.user-row {
  justify-content: flex-end;
}

.user-bubble {
  max-width: 76%;
  padding: 20rpx 28rpx;
  background: #1677ff;
  color: #ffffff;
  border-radius: 28rpx 8rpx 28rpx 28rpx;
  font-size: 30rpx;
  font-weight: 500;
  line-height: 1.65;
  box-shadow: 0 8rpx 18rpx rgba(22, 119, 255, 0.16);
}

.ai-row {
  align-items: flex-start;
}

.ai-avatar {
  width: 58rpx;
  height: 58rpx;
  margin-right: 16rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #1677ff 0%, #4da3ff 100%);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 58rpx;
  text-align: center;
  flex-shrink: 0;
  box-shadow: 0 8rpx 20rpx rgba(22, 119, 255, 0.16);
}

.ai-card {
  flex: 1;
  min-width: 0;
  padding: 26rpx 28rpx 22rpx;
  background: #ffffff;
  border-radius: 8rpx 24rpx 24rpx 24rpx;
  border: 1rpx solid rgba(22, 119, 255, 0.08);
  box-shadow: 0 4rpx 18rpx rgba(22, 119, 255, 0.07);
}

.answer-content {
  color: #1a1a1a;
}

.answer-paragraph {
  margin-bottom: 22rpx;
  font-size: 30rpx;
  line-height: 1.75;
}

.answer-paragraph:last-child {
  margin-bottom: 0;
}

.answer-segment,
.answer-text {
  color: #1a1a1a;
  font-size: 30rpx;
  line-height: 1.75;
}

.answer-strong {
  font-weight: 700;
}

.answer-text {
  white-space: pre-wrap;
}

.low-confidence {
  margin-bottom: 18rpx;
  padding: 14rpx 18rpx;
  border-radius: 12rpx;
  background: #fffbeb;
  color: #f59e0b;
  font-size: 24rpx;
  line-height: 1.5;
  border: 1rpx solid rgba(245, 158, 11, 0.16);
}

.citation-card {
  margin-top: 24rpx;
  background: #f4f8ff;
  border: 1rpx solid #e6f0ff;
  border-radius: 16rpx;
  overflow: hidden;
}

.citation-header {
  width: 100%;
  min-height: 72rpx;
  padding: 18rpx 22rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.citation-title {
  gap: 12rpx;
  color: #1677ff;
  font-size: 26rpx;
  font-weight: 600;
}

.file-icon {
  color: #1677ff;
  font-size: 24rpx;
  line-height: 1;
}

.citation-count {
  min-width: 34rpx;
  height: 34rpx;
  padding: 0 8rpx;
  border-radius: 18rpx;
  background: #1677ff;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 34rpx;
  text-align: center;
}

.citation-arrow {
  color: #1677ff;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1;
}

.citation-list {
  padding: 0 22rpx;
  border-top: 1rpx solid #e6f0ff;
}

.citation-item {
  width: 100%;
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #ededed;
}

.citation-item:last-child {
  border-bottom: 0;
}

.citation-index {
  width: 34rpx;
  height: 34rpx;
  margin: 2rpx 14rpx 0 0;
  border-radius: 10rpx;
  background: #1677ff;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 34rpx;
  text-align: center;
  flex-shrink: 0;
}

.citation-body {
  flex: 1;
  min-width: 0;
}

.citation-line {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.citation-name {
  flex: 1;
  color: #1a1a1a;
  font-size: 26rpx;
  font-weight: 600;
}

.score {
  padding: 3rpx 10rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.score.good {
  color: #10b981;
  background: #ecfdf5;
}

.score.warn {
  color: #f59e0b;
  background: #fffbeb;
}

.citation-path,
.citation-excerpt {
  margin-top: 7rpx;
  color: #888888;
  font-size: 22rpx;
  line-height: 1.55;
}

.feedback-bar {
  display: flex;
  gap: 8rpx;
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #ededed;
}

.feedback-btn {
  flex: 1;
  min-width: 0;
  flex-direction: column;
  justify-content: center;
  gap: 4rpx;
  color: #bdbdbd;
  font-size: 22rpx;
  line-height: 1.2;
  text-align: center;
}

.feedback-btn.active {
  color: #1677ff;
}

.feedback-btn.danger {
  color: #ef4444;
}

.feedback-icon {
  color: inherit;
  font-size: 28rpx;
  line-height: 1;
}

.input-placeholder {
  height: 140rpx;
}

.question-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
  padding: 18rpx 24rpx 18rpx;
  background: #ffffff;
  border-top: 1rpx solid #ededed;
}

.question-bar button {
  min-width: 0;
  margin: 0;
  padding: 0;
  line-height: normal;
  overflow: hidden;
}

.voice-btn {
  width: 72rpx;
  min-width: 72rpx;
  max-width: 72rpx;
  height: 72rpx;
  min-height: 72rpx;
  max-height: 72rpx;
  flex: 0 0 72rpx;
  border-radius: 36rpx;
  background: #f5f5f5;
  justify-content: center;
}

.mic-icon {
  width: 28rpx;
  height: 36rpx;
  position: relative;
}

.mic-head {
  position: absolute;
  left: 8rpx;
  top: 0;
  width: 12rpx;
  height: 22rpx;
  border: 4rpx solid #888888;
  border-radius: 12rpx;
}

.mic-stem {
  position: absolute;
  left: 12rpx;
  top: 24rpx;
  width: 4rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: #888888;
}

.mic-base {
  position: absolute;
  left: 5rpx;
  bottom: 0;
  width: 18rpx;
  height: 4rpx;
  border-radius: 4rpx;
  background: #888888;
}

.input-shell {
  flex: 1;
  min-width: 0;
  min-height: 72rpx;
  border-radius: 16rpx;
  background: #f5f5f5;
  overflow: hidden;
}

.question-input {
  width: 100%;
  min-height: 72rpx;
  max-height: 168rpx;
  padding: 18rpx 22rpx;
  background: transparent;
  color: #1a1a1a;
  font-size: 28rpx;
  line-height: 1.35;
}

.question-placeholder {
  color: #bdbdbd;
}

.send-btn {
  width: 72rpx;
  min-width: 72rpx;
  max-width: 72rpx;
  height: 72rpx;
  min-height: 72rpx;
  max-height: 72rpx;
  flex: 0 0 72rpx;
  border-radius: 16rpx;
  background: #bdbdbd;
  justify-content: center;
}

.send-btn.enabled {
  background: #1677ff;
}

.send-plane {
  width: 0;
  height: 0;
  border-left: 28rpx solid #ffffff;
  border-top: 15rpx solid transparent;
  border-bottom: 15rpx solid transparent;
  transform: rotate(-18deg) translateX(2rpx);
}

.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 99;
  background: rgba(0, 0, 0, 0.42);
  display: flex;
  align-items: flex-end;
}

.kb-sheet {
  width: 100%;
  max-height: 70vh;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  overflow: hidden;
}

.sheet-handle {
  width: 72rpx;
  height: 8rpx;
  margin: 22rpx auto 16rpx;
  border-radius: 8rpx;
  background: #ededed;
}

.sheet-head {
  height: 72rpx;
  padding: 0 44rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #ededed;
}

.sheet-title {
  color: #1a1a1a;
  font-size: 34rpx;
  font-weight: 700;
}

.sheet-close {
  width: 48rpx;
  height: 48rpx;
  color: #888888;
  font-size: 54rpx;
  font-weight: 300;
  line-height: 44rpx;
  text-align: center;
}

.sheet-list {
  width: 100%;
  max-height: calc(70vh - 118rpx);
}

.sheet-kb-cell {
  width: 100%;
  box-sizing: border-box;
  min-height: 136rpx;
  padding: 24rpx 34rpx;
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid #ededed;
}

.sheet-kb-cell.is-disabled {
  opacity: 0.45;
}

.sheet-kb-icon {
  width: 92rpx;
  height: 92rpx;
  margin-right: 24rpx;
  border-radius: 22rpx;
  background: #e6f0ff;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 92rpx;
}

.sheet-kb-icon.locked {
  background: #f5f5f5;
}

.sheet-kb-content {
  flex: 1;
  min-width: 0;
}

.sheet-kb-title-row {
  display: flex;
  align-items: center;
  min-width: 0;
}

.sheet-kb-title {
  max-width: 250rpx;
  color: #1a1a1a;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.2;
}

.sheet-permission {
  margin-left: 14rpx;
  padding: 3rpx 12rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.25;
  flex: 0 0 auto;
}

.sheet-permission.granted {
  color: #10b981;
  background: #ecfdf5;
}

.sheet-permission.denied {
  color: #ff7a7a;
  background: #fff1f1;
}

.sheet-kb-desc {
  margin-top: 12rpx;
  color: #888888;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.25;
}

.sheet-kb-meta {
  margin-top: 10rpx;
  color: #bdbdbd;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.25;
}

.sheet-check,
.sheet-arrow {
  width: 34rpx;
  margin-left: 18rpx;
  color: #3478ff;
  font-size: 40rpx;
  line-height: 1;
  text-align: right;
  flex: 0 0 34rpx;
}

.sheet-arrow {
  color: #bdbdbd;
}
