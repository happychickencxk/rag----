page {
  background: #f7f8fa;
}

.chat-page {
  padding: 16rpx 24rpx 0;
}

.top-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.icon-btn {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #1677ff;
  font-size: 24rpx;
}

.kb-picker {
  width: 100%;
  min-height: 104rpx;
  padding: 20rpx 24rpx;
  background: #ffffff;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(22, 119, 255, 0.08);
}

.kb-main {
  display: flex;
  align-items: center;
  min-width: 0;
}

.kb-icon,
.welcome-icon,
.ai-avatar {
  width: 52rpx;
  height: 52rpx;
  border-radius: 16rpx;
  background: #e6f0ff;
  color: #1677ff;
  font-weight: 600;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 18rpx;
}

.kb-name {
  font-size: 30rpx;
  color: #1a1a1a;
  font-weight: 600;
}

.kb-desc {
  font-size: 22rpx;
  color: #888888;
  margin-top: 6rpx;
}

.kb-change {
  color: #1677ff;
  font-size: 24rpx;
  flex-shrink: 0;
}

.welcome {
  display: flex;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.welcome-icon {
  width: 76rpx;
  height: 76rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #1677ff, #4da3ff);
}

.welcome-content {
  flex: 1;
}

.welcome-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.welcome-text {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.7;
}

.section-label {
  font-size: 22rpx;
  color: #bdbdbd;
  margin-bottom: 14rpx;
  font-weight: 600;
}

.chip-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.chip {
  padding: 10rpx 22rpx;
  background: #e6f0ff;
  border: 1rpx solid rgba(22, 119, 255, 0.18);
  color: #1677ff;
  font-size: 24rpx;
  border-radius: 999rpx;
}

.message-list {
  margin-top: 28rpx;
}

.message-row {
  display: flex;
  margin-bottom: 24rpx;
}

.user-row {
  justify-content: flex-end;
}

.user-bubble {
  max-width: 76%;
  padding: 20rpx 26rpx;
  background: #1677ff;
  color: #ffffff;
  border-radius: 28rpx 6rpx 28rpx 28rpx;
  font-size: 28rpx;
  line-height: 1.7;
}

.ai-row {
  align-items: flex-start;
}

.ai-card {
  flex: 1;
  min-width: 0;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx;
  border: 1rpx solid #ededed;
}

.answer-text {
  white-space: pre-wrap;
  font-size: 28rpx;
  color: #1a1a1a;
  line-height: 1.75;
}

.low-confidence {
  background: #fff3e0;
  color: #fa8919;
  border-radius: 12rpx;
  padding: 14rpx 18rpx;
  margin-bottom: 18rpx;
  font-size: 24rpx;
}

.citation-card {
  margin-top: 22rpx;
  background: #f4f8ff;
  border: 1rpx solid #e6f0ff;
  border-radius: 18rpx;
  overflow: hidden;
}

.citation-header {
  width: 100%;
  padding: 18rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.citation-title {
  color: #1677ff;
  font-size: 26rpx;
  font-weight: 600;
}

.citation-count {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 32rpx;
  height: 32rpx;
  margin-left: 8rpx;
  border-radius: 16rpx;
  background: #1677ff;
  color: #ffffff;
  font-size: 20rpx;
}

.citation-arrow {
  color: #888888;
  font-size: 22rpx;
}

.citation-list {
  border-top: 1rpx solid #e6f0ff;
  padding: 0 20rpx;
}

.citation-item {
  width: 100%;
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #ededed;
}

.citation-item:last-child {
  border-bottom: 0;
}

.citation-index {
  width: 36rpx;
  height: 36rpx;
  background: #1677ff;
  color: #ffffff;
  border-radius: 10rpx;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 16rpx;
}

.citation-body {
  flex: 1;
  min-width: 0;
}

.citation-line {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.citation-name {
  flex: 1;
  font-size: 26rpx;
  color: #1a1a1a;
  font-weight: 600;
}

.score {
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  flex-shrink: 0;
}

.score.good {
  color: #10b981;
  background: #ecfdf5;
}

.score.warn {
  color: #fa8919;
  background: #fff3e0;
}

.citation-path,
.citation-excerpt {
  color: #888888;
  font-size: 22rpx;
  line-height: 1.55;
  margin-top: 6rpx;
}

.feedback-bar {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #ededed;
  flex-wrap: wrap;
}

.feedback-btn {
  color: #888888;
  font-size: 24rpx;
}

.feedback-btn.active {
  color: #1677ff;
}

.feedback-btn.danger {
  color: #ef4444;
}

.input-placeholder {
  height: 146rpx;
}

.question-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
  padding: 18rpx 24rpx 18rpx;
  background: #ffffff;
  border-top: 1rpx solid #ededed;
}

.voice-btn {
  height: 72rpx;
  padding: 0 18rpx;
  border-radius: 16rpx;
  background: #f5f5f5;
  color: #1677ff;
  font-size: 24rpx;
  line-height: 72rpx;
}

.question-input {
  flex: 1;
  min-height: 72rpx;
  max-height: 168rpx;
  padding: 18rpx 22rpx;
  background: #f5f5f5;
  border-radius: 16rpx;
  font-size: 26rpx;
  line-height: 1.45;
}

.send-btn {
  height: 72rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  background: #c8c8c8;
  color: #ffffff;
  line-height: 72rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.send-btn.enabled {
  background: #1677ff;
}
