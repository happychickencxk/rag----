.chat-page {
  min-height: 100vh;
  background: #f7f8fa;
}

.kb-strip {
  width: 100%;
  box-sizing: border-box;
  height: 82rpx;
  padding: 0 32rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #ededed;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.kb-left,
.kb-right,
.citation-title,
.feedback-btn,
.voice-btn,
.upload-btn,
.cancel-btn,
.send-btn {
  display: flex;
  align-items: center;
}

.kb-left {
  min-width: 0;
}

.kb-icon {
  width: 42rpx;
  height: 42rpx;
  border-radius: 12rpx;
  background: #e6f0ff;
  margin-right: 18rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
}

.kb-icon-image {
  width: 26rpx;
  height: 26rpx;
  filter: brightness(0) saturate(100%) invert(39%) sepia(97%) saturate(2816%) hue-rotate(204deg) brightness(100%) contrast(104%);
}

.kb-name {
  max-width: 300rpx;
  color: #1a1a1a;
  font-size: 30rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.kb-status {
  margin-left: 16rpx;
  padding: 3rpx 10rpx;
  border-radius: 8rpx;
  background: #ecfdf5;
  color: #10b981;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.25;
  flex-shrink: 0;
}

.kb-right {
  gap: 8rpx;
  height: 42rpx;
  color: #888888;
  font-size: 26rpx;
  flex-shrink: 0;
}

.kb-switch-label {
  line-height: 42rpx;
}

.chevron {
  width: 12rpx;
  height: 12rpx;
  margin: -6rpx 2rpx 0 2rpx;
  border-right: 3rpx solid #888888;
  border-bottom: 3rpx solid #888888;
  transform: rotate(45deg);
}

.conversation {
  padding: 24rpx 28rpx 0;
}

.example-section {
  padding: 8rpx 0 12rpx 74rpx;
}

.example-title {
  margin-bottom: 16rpx;
  color: #888888;
  font-size: 24rpx;
  font-weight: 600;
}

.example-question {
  width: 100%;
  min-height: 72rpx;
  box-sizing: border-box;
  margin-bottom: 14rpx;
  padding: 16rpx 20rpx;
  border: 1rpx solid #dbeafe;
  border-radius: 8rpx;
  background: #eef5ff;
  color: #1677ff;
  display: flex;
  align-items: center;
  transition: background-color 200ms ease, border-color 200ms ease;
}

.example-question:active {
  background: #e0edff;
  border-color: #b8d4ff;
}

.example-question-text {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  line-height: 1.45;
}

.example-arrow {
  margin-left: 16rpx;
  color: #8bb8ff;
  font-size: 34rpx;
  line-height: 1;
}

.message-row {
  display: flex;
  margin-bottom: 26rpx;
}

.user-row {
  justify-content: flex-end;
}

.user-bubble {
  max-width: 76%;
  padding: 20rpx 28rpx;
  background: #1677ff;
  color: #ffffff;
  border-radius: 28rpx 8rpx 28rpx 28rpx;
  font-size: 30rpx;
  font-weight: 500;
  line-height: 1.65;
  box-shadow: 0 8rpx 18rpx rgba(22, 119, 255, 0.16);
}

.ai-row {
  align-items: flex-start;
}

.ai-avatar {
  width: 58rpx;
  height: 58rpx;
  margin-right: 16rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #1677ff 0%, #4da3ff 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 8rpx 20rpx rgba(22, 119, 255, 0.16);
}

.ai-avatar-image {
  width: 38rpx;
  height: 38rpx;
  filter: brightness(0) invert(1);
}

.ai-card {
  flex: 1;
  min-width: 0;
  padding: 26rpx 28rpx 22rpx;
  background: #ffffff;
  border-radius: 8rpx 24rpx 24rpx 24rpx;
  border: 1rpx solid rgba(22, 119, 255, 0.08);
  box-shadow: 0 4rpx 18rpx rgba(22, 119, 255, 0.07);
}

.previous-answer-label {
  display: inline-block;
  margin-bottom: 14rpx;
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
  background: #f5f5f5;
  color: #888888;
  font-size: 20rpx;
}

.answer-content {
  color: #1a1a1a;
}

.answer-paragraph {
  margin-bottom: 22rpx;
  font-size: 30rpx;
  line-height: 1.75;
}

.answer-paragraph:last-child {
  margin-bottom: 0;
}

.answer-segment,
.answer-text {
  color: #1a1a1a;
  font-size: 30rpx;
  line-height: 1.75;
}

.answer-strong {
  font-weight: 700;
}

.answer-text {
  white-space: pre-wrap;
}

.low-confidence {
  margin-bottom: 18rpx;
  padding: 14rpx 18rpx;
  border-radius: 12rpx;
  background: #fffbeb;
  color: #f59e0b;
  font-size: 24rpx;
  line-height: 1.5;
  border: 1rpx solid rgba(245, 158, 11, 0.16);
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
}

.low-confidence-icon {
  width: 28rpx;
  height: 28rpx;
  margin-top: 3rpx;
  flex: 0 0 28rpx;
  filter: brightness(0) saturate(100%) invert(62%) sepia(99%) saturate(1228%) hue-rotate(357deg) brightness(102%) contrast(96%);
}

.qa-status-card {
  margin-bottom: 18rpx;
  padding: 18rpx;
  border: 1rpx solid transparent;
  border-radius: 12rpx;
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
}

.qa-status-card.warning {
  background: #fffbeb;
  border-color: rgba(245, 158, 11, 0.18);
}

.qa-status-card.danger {
  background: #fff1f1;
  border-color: rgba(239, 68, 68, 0.16);
}

.qa-status-icon {
  width: 34rpx;
  height: 34rpx;
  margin-top: 2rpx;
  flex: 0 0 34rpx;
}

.qa-status-card.warning .qa-status-icon {
  filter: brightness(0) saturate(100%) invert(62%) sepia(99%) saturate(1228%) hue-rotate(357deg) brightness(102%) contrast(96%);
}

.qa-status-card.danger .qa-status-icon {
  filter: brightness(0) saturate(100%) invert(38%) sepia(85%) saturate(2339%) hue-rotate(337deg) brightness(100%) contrast(88%);
}

.qa-status-content {
  flex: 1;
  min-width: 0;
}

.qa-status-title {
  color: #1a1a1a;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.35;
}

.qa-status-desc {
  margin-top: 6rpx;
  color: #888888;
  font-size: 23rpx;
  line-height: 1.5;
}

.qa-status-retry {
  display: inline-block;
  margin-top: 12rpx;
  color: #1677ff;
  font-size: 23rpx;
  font-weight: 600;
}

.cancelled-note {
  margin-bottom: 14rpx;
  color: #888888;
  font-size: 23rpx;
}

.citation-card {
  margin-top: 24rpx;
  background: #f4f8ff;
  border: 1rpx solid #e6f0ff;
  border-radius: 16rpx;
  overflow: hidden;
}

.citation-header {
  width: 100%;
  min-height: 72rpx;
  padding: 18rpx 22rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.citation-title {
  gap: 12rpx;
  margin-left: 165rpx;
  color: #1677ff;
  font-size: 26rpx;
  font-weight: 600;
}

.source-icon {
  width: 28rpx;
  height: 28rpx;
  flex: 0 0 24rpx;
  filter: brightness(0) saturate(100%) invert(39%) sepia(97%) saturate(2816%) hue-rotate(204deg) brightness(100%) contrast(104%);
}

.citation-count {
  min-width: 34rpx;
  height: 34rpx;
  padding: 0 8rpx;
  border-radius: 18rpx;
  background: #1677ff;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 34rpx;
  text-align: center;
}

.citation-arrow {
  color: #1677ff;
  font-size: 28rpx;
  margin-bottom: 10rpx;
  font-weight: 700;
  line-height: 1;
}

.citation-list {
  padding: 10rpx 12rpx;
  border-top: 1rpx solid #e6f0ff;
}

.citation-item {
  width: 100%;
  display: flex;
  padding: 20rpx 4rpx;
  position: relative;
  border-bottom: 1rpx solid #ededed;
}

.citation-item:last-child {
  border-bottom: 0;
}

.citation-index {
  width: 34rpx;
  height: 34rpx;
  position: absolute;
  left: 4rpx;
  top: 22rpx;
  border-radius: 10rpx;
  background: #1677ff;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 34rpx;
  text-align: center;
  flex-shrink: 0;
}

.citation-body {
  width: 100%;
  flex: 1;
  min-width: 0;
}

.citation-line {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding-left: 48rpx;
}

.citation-name {
  flex: 1;
  color: #1a1a1a;
  font-size: 26rpx;
  font-weight: 600;
}

.score {
  padding: 3rpx 10rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.score.good {
  color: #10b981;
  background: #ecfdf5;
}

.score.warn {
  color: #f59e0b;
  background: #fffbeb;
}

.citation-location,
.citation-path {
  margin-top: 7rpx;
  color: #888888;
  font-size: 22rpx;
  line-height: 1.55;
}

.citation-location {
  color: #1677ff;
  font-weight: 600;
}

.feedback-bar {
  display: flex;
  gap: 8rpx;
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #ededed;
}

.feedback-btn {
  flex: 1;
  min-width: 0;
  flex-direction: column;
  justify-content: center;
  gap: 4rpx;
  color: #bdbdbd;
  font-size: 22rpx;
  line-height: 1.2;
  text-align: center;
  transition: color 200ms ease, opacity 200ms ease;
}

.feedback-btn.active {
  color: #1677ff;
}

.feedback-btn.danger {
  color: #ef4444;
}

.feedback-action-icon {
  width: 28rpx;
  height: 28rpx;
  display: block;
  filter: brightness(0);
  opacity: 0.26;
  transition: filter 200ms ease, opacity 200ms ease, transform 200ms ease;
}

.thumb-down-icon {
  transform: rotate(180deg);
}

.feedback-btn.active .feedback-action-icon {
  filter: brightness(0) saturate(100%) invert(39%) sepia(97%) saturate(2816%) hue-rotate(204deg) brightness(100%) contrast(104%);
  opacity: 1;
}

.feedback-btn.danger .feedback-action-icon {
  filter: brightness(0) saturate(100%) invert(38%) sepia(85%) saturate(2339%) hue-rotate(337deg) brightness(100%) contrast(88%);
  opacity: 1;
}

.input-placeholder {
  height: 250rpx;
}

.question-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(100rpx + env(safe-area-inset-bottom));
  z-index: 10;
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
  padding: 18rpx 24rpx 18rpx;
  background: #ffffff;
  border-top: 1rpx solid #ededed;
}

.voice-btn,
.upload-btn,
.cancel-btn,
.send-btn {
  min-width: 0;
  margin: 0;
  padding: 0;
  line-height: normal;
  overflow: hidden;
}

.upload-btn {
  width: 64rpx;
  min-width: 64rpx;
  max-width: 64rpx;
  height: 72rpx;
  min-height: 72rpx;
  max-height: 72rpx;
  flex: 0 0 64rpx;
  justify-content: center;
}

.upload-icon {
  width: 38rpx;
  height: 38rpx;
  filter: brightness(0);
  opacity: 0.42;
  transition: opacity 200ms ease, filter 200ms ease;
}

.voice-btn {
  width: 72rpx;
  min-width: 72rpx;
  max-width: 72rpx;
  height: 72rpx;
  min-height: 72rpx;
  max-height: 72rpx;
  flex: 0 0 72rpx;
  border-radius: 36rpx;
  background: #f5f5f5;
  justify-content: center;
}

.voice-icon {
  width: 38rpx;
  height: 38rpx;
  filter: brightness(0);
  opacity: 0.48;
}

.input-shell {
  position: relative;
  flex: 1;
  min-width: 0;
  min-height: 72rpx;
  border-radius: 16rpx;
  background: #f5f5f5;
  overflow: hidden;
}

.question-input {
  width: 100%;
  box-sizing: border-box;
  min-height: 72rpx;
  max-height: 168rpx;
  padding: 18rpx 66rpx 18rpx 22rpx;
  background: transparent;
  color: #1a1a1a;
  font-size: 28rpx;
  line-height: 1.35;
}

.question-placeholder {
  color: #bdbdbd;
}

.input-clear {
  width: 52rpx;
  height: 52rpx;
  min-width: 52rpx;
  margin: 0;
  padding: 0;
  position: absolute;
  right: 8rpx;
  bottom: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.input-clear-icon {
  width: 24rpx;
  height: 24rpx;
  filter: brightness(0);
  opacity: 0.3;
}

.cancel-btn,
.send-btn {
  width: 72rpx;
  min-width: 72rpx;
  max-width: 72rpx;
  height: 72rpx;
  min-height: 72rpx;
  max-height: 72rpx;
  flex: 0 0 72rpx;
  border-radius: 16rpx;
  background: #bdbdbd;
  justify-content: center;
  transition: background-color 200ms ease, opacity 200ms ease;
}

.cancel-btn {
  background: #eef5ff;
  justify-content: center;
}

.cancel-square {
  width: 24rpx;
  height: 24rpx;
  border-radius: 4rpx;
  background: #1677ff;
}

.send-btn.enabled {
  background: #1677ff;
}

.send-icon {
  width: 38rpx;
  height: 38rpx;
  filter: brightness(0) invert(1);
  opacity: 0.78;
  transition: opacity 200ms ease, filter 200ms ease;
}

.send-btn.enabled .send-icon {
  opacity: 1;
}

.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: calc(100rpx + env(safe-area-inset-bottom));
  z-index: 99;
  background: rgba(0, 0, 0, 0.42);
  display: flex;
  align-items: flex-end;
}

.kb-sheet {
  width: 100%;
  max-height: 70vh;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  overflow: hidden;
}

.sheet-handle {
  width: 72rpx;
  height: 8rpx;
  margin: 22rpx auto 16rpx;
  border-radius: 8rpx;
  background: #ededed;
}

.sheet-head {
  height: 72rpx;
  padding: 0 0 0 44rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #ededed;
}

.sheet-title {
  color: #1a1a1a;
  font-size: 34rpx;
  font-weight: 700;
}

.sheet-close {
  width: 48rpx;
  height: 48rpx;
  margin: 0;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.sheet-close-icon {
  width: 30rpx;
  height: 30rpx;
  filter: brightness(0);
  margin-left:0rpx;
  opacity: 0.46;
}

.sheet-list {
  width: 100%;
  max-height: calc(70vh - 210rpx);
}

.sheet-search {
  height: 92rpx;
  margin: 0 32rpx;
  padding: 0 22rpx;
  border-bottom: 1rpx solid #ededed;
  display: flex;
  align-items: center;
}

.sheet-search-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 12rpx;
  filter: brightness(0);
  opacity: 0.28;
}

.sheet-search-input {
  flex: 1;
  min-width: 0;
  color: #1a1a1a;
  font-size: 26rpx;
}

.sheet-empty {
  padding: 72rpx 32rpx;
  color: #bdbdbd;
  font-size: 26rpx;
  text-align: center;
}

.sheet-kb-cell {
  width: 100%;
  box-sizing: border-box;
  min-height: 136rpx;
  padding: 24rpx 34rpx;
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid #ededed;
}

.sheet-kb-cell.is-disabled {
  opacity: 0.45;
}

.sheet-kb-icon {
  width: 92rpx;
  height: 92rpx;
  margin-right: 24rpx;
  border-radius: 22rpx;
  background: #e6f0ff;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 92rpx;
}

.sheet-kb-icon.locked {
  background: #f5f5f5;
}

.sheet-kb-image {
  width: 46rpx;
  height: 46rpx;
  filter: brightness(0) saturate(100%) invert(39%) sepia(97%) saturate(2816%) hue-rotate(204deg) brightness(100%) contrast(104%);
}

.sheet-kb-icon.locked .sheet-kb-image {
  filter: brightness(0) saturate(100%) invert(38%) sepia(85%) saturate(2339%) hue-rotate(337deg) brightness(100%) contrast(88%);
}

.sheet-kb-content {
  flex: 1;
  min-width: 0;
}

.sheet-kb-title-row {
  display: flex;
  align-items: center;
  min-width: 0;
}

.sheet-kb-title {
  max-width: 250rpx;
  color: #1a1a1a;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.2;
}

.sheet-permission {
  margin-left: 14rpx;
  padding: 3rpx 12rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.25;
  flex: 0 0 auto;
}

.sheet-permission.granted {
  color: #10b981;
  background: #ecfdf5;
}

.sheet-permission.denied {
  color: #ff7a7a;
  background: #fff1f1;
}

.sheet-kb-desc {
  margin-top: 12rpx;
  color: #888888;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.25;
}

.sheet-kb-meta {
  margin-top: 10rpx;
  color: #bdbdbd;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.25;
}

.sheet-check,
.sheet-arrow {
  width: 34rpx;
  margin-left: 18rpx;
  color: #3478ff;
  font-size: 40rpx;
  line-height: 1;
  text-align: right;
  flex: 0 0 34rpx;
}

.sheet-arrow {
  color: #bdbdbd;
}

/* 加载中状态 */
.state-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx 0;
  color: #888888;
  font-size: 26rpx;
}

.state-spinner-small {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #f0f0f0;
  border-top-color: #1677ff;
  border-radius: 50%;
  margin-bottom: 16rpx;
  animation: chat-spin 800ms linear infinite;
}

@keyframes chat-spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* AI 消息错误状态 */
.state-error-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0;
}

.error-icon {
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 10rpx;
  filter: brightness(0) saturate(100%) invert(38%) sepia(85%) saturate(2339%) hue-rotate(337deg) brightness(100%) contrast(88%);
}

.error-text {
  color: #ef4444;
  font-size: 26rpx;
  text-align: center;
  line-height: 1.5;
}

.error-retry {
  margin-top: 14rpx;
  padding: 10rpx 32rpx;
  color: #1677ff;
  font-size: 24rpx;
  border: 1rpx solid #1677ff;
  border-radius: 10rpx;
}

/* 受限引用 */
.citation-restricted {
  color: #ef4444 !important;
}

/* 流式输出指示器 */
.streaming-indicator {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  gap: 8rpx;
  color: #1677ff;
  font-size: 24rpx;
}

.streaming-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 6rpx;
  background: #1677ff;
  animation: stream-dot-pulse 800ms ease-in-out infinite;
}

@keyframes stream-dot-pulse {
  0%, 100% { opacity: 0.3; }
  50% { opacity: 1; }
}

/* 流式文本闪烁光标 */
.streaming-text {
  white-space: pre-wrap;
}

.streaming-cursor {
  display: inline;
  color: #1677ff;
  animation: cursor-blink 600ms step-end infinite;
}

@keyframes cursor-blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0; }
}
