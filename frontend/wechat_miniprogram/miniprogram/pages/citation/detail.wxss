.citation-page {
  padding: 24rpx;
}

.doc-card,
.score-card,
.content-card {
  padding: 28rpx;
  margin-bottom: 22rpx;
}

.doc-title-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.doc-source-icon {
  width: 38rpx;
  height: 38rpx;
  margin-top: 6rpx;
  flex: 0 0 38rpx;
  filter: brightness(0) saturate(100%) invert(39%) sepia(97%) saturate(2816%) hue-rotate(204deg) brightness(100%) contrast(104%);
}

.doc-title {
  font-size: 34rpx;
  color: #1a1a1a;
  font-weight: 700;
  line-height: 1.5;
  margin-bottom: 0;
}

.doc-meta {
  color: #666666;
  font-size: 26rpx;
  line-height: 1.7;
}

.permission {
  display: inline-block;
  margin-top: 16rpx;
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
  font-size: 22rpx;
}

.permission.ok {
  color: #10b981;
  background: #ecfdf5;
}

.permission.limited {
  color: #fa8919;
  background: #fff3e0;
}

.score-card {
  display: flex;
}

.score-item {
  flex: 1;
  text-align: center;
}

.score-value {
  color: #1677ff;
  font-size: 42rpx;
  font-weight: 700;
}

.score-label {
  color: #888888;
  font-size: 24rpx;
  margin-top: 6rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 18rpx;
}

.highlight {
  background: #e6f0ff;
  color: #1677ff;
  padding: 18rpx;
  border-radius: 14rpx;
  font-size: 27rpx;
  line-height: 1.65;
  margin-bottom: 18rpx;
}

.excerpt {
  color: #1a1a1a;
  font-size: 28rpx;
  line-height: 1.75;
}

.clamp {
  display: -webkit-box;
  overflow: hidden;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
}

.expand-btn {
  width: 300rpx;
  margin-top: 18rpx;
  padding: 8rpx 12rpx;
  color: #1677ff;
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: space-between;
  transition: color 200ms ease, background-color 200ms ease;
}

.expand-chevron {
  width: 14rpx;
  height: 14rpx;
  margin: -6rpx 4rpx 0 16rpx;
  border-right: 3rpx solid #1677ff;
  border-bottom: 3rpx solid #1677ff;
  transform: rotate(45deg);
  transition: transform 200ms ease, border-color 200ms ease;
}

.expand-chevron.is-expanded {
  margin-top: 6rpx;
  transform: rotate(225deg);
}

.limited-tip {
  margin-top: 18rpx;
  padding: 16rpx;
  background: #fff3e0;
  color: #fa8919;
  border-radius: 12rpx;
  font-size: 24rpx;
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.limited-icon {
  width: 30rpx;
  height: 30rpx;
  flex: 0 0 30rpx;
  filter: brightness(0) saturate(100%) invert(62%) sepia(99%) saturate(1228%) hue-rotate(357deg) brightness(102%) contrast(96%);
}

.action-bar {
  display: flex;
  gap: 18rpx;
}

.action {
  flex: 1;
  height: 88rpx;
  border-radius: 18rpx;
  background: #ffffff;
  color: #1677ff;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  transition: color 200ms ease, background-color 200ms ease, opacity 200ms ease;
}

.action.primary {
  background: #1677ff;
  color: #ffffff;
}

.action-icon {
  width: 30rpx;
  height: 30rpx;
  filter: brightness(0);
  opacity: 0.56;
  transition: filter 200ms ease, opacity 200ms ease;
}

.copy-action-icon {
  filter: none;
  opacity: 1;
}
