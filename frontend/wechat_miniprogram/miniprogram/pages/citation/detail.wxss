page {
  background: #f7f8fa;
}

.citation-page {
  padding: 24rpx;
}

.doc-card,
.score-card,
.content-card {
  padding: 28rpx;
  margin-bottom: 22rpx;
}

.doc-title {
  font-size: 34rpx;
  color: #1a1a1a;
  font-weight: 700;
  line-height: 1.5;
  margin-bottom: 16rpx;
}

.doc-meta {
  color: #666666;
  font-size: 26rpx;
  line-height: 1.7;
}

.permission {
  display: inline-block;
  margin-top: 16rpx;
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
  font-size: 22rpx;
}

.permission.ok {
  color: #10b981;
  background: #ecfdf5;
}

.permission.limited {
  color: #fa8919;
  background: #fff3e0;
}

.score-card {
  display: flex;
}

.score-item {
  flex: 1;
  text-align: center;
}

.score-value {
  color: #1677ff;
  font-size: 42rpx;
  font-weight: 700;
}

.score-label {
  color: #888888;
  font-size: 24rpx;
  margin-top: 6rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 18rpx;
}

.highlight {
  background: #e6f0ff;
  color: #1677ff;
  padding: 18rpx;
  border-radius: 14rpx;
  font-size: 27rpx;
  line-height: 1.65;
  margin-bottom: 18rpx;
}

.excerpt {
  color: #1a1a1a;
  font-size: 28rpx;
  line-height: 1.75;
}

.clamp {
  display: -webkit-box;
  overflow: hidden;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
}

.expand-btn {
  margin-top: 18rpx;
  color: #1677ff;
  font-size: 26rpx;
}

.limited-tip {
  margin-top: 18rpx;
  padding: 16rpx;
  background: #fff3e0;
  color: #fa8919;
  border-radius: 12rpx;
  font-size: 24rpx;
}

.action-bar {
  display: flex;
  gap: 18rpx;
}

.action {
  flex: 1;
  height: 88rpx;
  border-radius: 18rpx;
  background: #ffffff;
  color: #1677ff;
  text-align: center;
  line-height: 88rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.action.primary {
  background: #1677ff;
  color: #ffffff;
}
