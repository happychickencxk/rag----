.citation-page {
  padding: 24rpx;
  min-height: 100vh;
}

/* 状态区域 */
.state-box {
  padding: 120rpx 48rpx;
  text-align: center;
}

.state-icon {
  width: 96rpx;
  height: 96rpx;
  margin-bottom: 24rpx;
  filter: brightness(0);
  opacity: 0.16;
}

.forbidden-icon {
  filter: brightness(0) saturate(100%) invert(38%) sepia(85%) saturate(2339%) hue-rotate(337deg) brightness(100%) contrast(88%);
  opacity: 1;
}

.state-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid #f0f0f0;
  border-top-color: #1677ff;
  border-radius: 50%;
  margin: 0 auto 20rpx;
  animation: cit-spin 800ms linear infinite;
}

@keyframes cit-spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.state-text {
  color: #888888;
  font-size: 26rpx;
}

.state-title {
  color: #1a1a1a;
  font-size: 30rpx;
  font-weight: 700;
}

.state-desc {
  margin-top: 12rpx;
  color: #888888;
  font-size: 26rpx;
  line-height: 1.5;
}

.doc-card,
.score-card,
.content-card {
  padding: 28rpx;
  margin-bottom: 22rpx;
}

.doc-title-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.doc-source-icon {
  width: 38rpx;
  height: 38rpx;
  margin-top: 6rpx;
  flex: 0 0 38rpx;
  filter: brightness(0) saturate(100%) invert(39%) sepia(97%) saturate(2816%) hue-rotate(204deg) brightness(100%) contrast(104%);
}

.doc-title {
  font-size: 34rpx;
  color: #1a1a1a;
  font-weight: 700;
  line-height: 1.5;
  margin-bottom: 0;
}

.doc-meta {
  color: #666666;
  font-size: 26rpx;
  line-height: 1.7;
}

.doc-location {
  margin: 8rpx 0;
  color: #1677ff;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 1.6;
}

.permission {
  display: inline-block;
  margin-top: 16rpx;
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
  font-size: 22rpx;
}

.permission.ok {
  color: #10b981;
  background: #ecfdf5;
}

.permission.limited {
  color: #fa8919;
  background: #fff3e0;
}

.score-card {
  display: flex;
}

.score-item {
  flex: 1;
  text-align: center;
}

.score-value {
  color: #1677ff;
  font-size: 42rpx;
  font-weight: 700;
}

.score-label {
  color: #888888;
  font-size: 24rpx;
  margin-top: 6rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 18rpx;
}

.source-loading {
  padding: 56rpx 0;
  color: #888888;
  font-size: 25rpx;
  text-align: center;
}

.source-scroll {
  width: 100%;
  height: 560rpx;
  border-top: 1rpx solid #ededed;
  border-bottom: 1rpx solid #ededed;
}

.source-block {
  padding: 22rpx 18rpx;
  border-bottom: 1rpx solid #ededed;
  transition: color 200ms ease, background-color 200ms ease, border-color 200ms ease;
}

.source-block:last-child {
  border-bottom: 0;
}

.source-block.is-target {
  padding-left: 22rpx;
  border-left: 6rpx solid #1677ff;
  background: #eef5ff;
}

.source-block-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  color: #666666;
  font-size: 23rpx;
  line-height: 1.5;
}

.source-block.is-target .source-block-head {
  color: #1677ff;
  font-weight: 600;
}

.target-badge {
  flex: 0 0 auto;
  padding: 3rpx 10rpx;
  border-radius: 8rpx;
  background: #1677ff;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 600;
}

.source-text {
  margin-top: 12rpx;
  color: #1a1a1a;
  font-size: 27rpx;
  line-height: 1.75;
  white-space: pre-wrap;
}

.limited-tip {
  margin-top: 18rpx;
  padding: 16rpx;
  background: #fff3e0;
  color: #fa8919;
  border-radius: 12rpx;
  font-size: 24rpx;
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.limited-icon {
  width: 30rpx;
  height: 30rpx;
  flex: 0 0 30rpx;
  filter: brightness(0) saturate(100%) invert(62%) sepia(99%) saturate(1228%) hue-rotate(357deg) brightness(102%) contrast(96%);
}

.action-bar {
  display: flex;
  gap: 18rpx;
}

.open-original {
  width: 100%;
  height: 88rpx;
  margin: 0 0 18rpx;
  border-radius: 16rpx;
  background: #1677ff;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  transition: color 200ms ease, background-color 200ms ease, opacity 200ms ease;
}

.open-original[disabled] {
  background: #c8c8c8;
  color: #ffffff;
  opacity: 1;
}

.open-original-icon {
  width: 32rpx;
  height: 32rpx;
  filter: brightness(0) invert(1);
}

.action {
  flex: 1;
  height: 88rpx;
  border-radius: 18rpx;
  background: #ffffff;
  color: #1677ff;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  transition: color 200ms ease, background-color 200ms ease, opacity 200ms ease;
}

.action-icon {
  width: 30rpx;
  height: 30rpx;
  filter: brightness(0);
  opacity: 0.56;
  transition: filter 200ms ease, opacity 200ms ease;
}
