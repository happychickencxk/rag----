.history-page {
  min-height: 100vh;
  padding-bottom: calc(100rpx + env(safe-area-inset-bottom));
  background: #f7f8fa;
}

.search-section {
  padding: 20rpx 38rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #ededed;
}

.search-box {
  height: 72rpx;
  padding: 0 24rpx;
  border-radius: 18rpx;
  background: #f5f5f5;
  display: flex;
  align-items: center;
}

.search-icon {
  width: 30rpx;
  height: 30rpx;
  margin-right: 12rpx;
  flex: 0 0 30rpx;
  filter: brightness(0);
  opacity: 0.26;
}

.search-input {
  flex: 1;
  min-width: 0;
  color: #1a1a1a;
  font-size: 28rpx;
}

.search-placeholder {
  color: #bdbdbd;
}

.group-title {
  height: 72rpx;
  padding: 0 44rpx;
  background: #f7f8fa;
  color: #bdbdbd;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 72rpx;
}

.session-list {
  width: 100%;
  background: #ffffff;
}

.session-cell {
  width: 100%;
  box-sizing: border-box;
  min-height: 142rpx;
  padding: 24rpx 28rpx 24rpx 44rpx;
  background: #ffffff;
  display: flex;
  align-items: flex-start;
  border-bottom: 1rpx solid #ededed;
}

.session-icon {
  width: 78rpx;
  height: 78rpx;
  margin-right: 24rpx;
  border-radius: 20rpx;
  background: #e6f0ff;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 78rpx;
}

.session-icon-image {
  width: 42rpx;
  height: 42rpx;
  filter: brightness(0) saturate(100%) invert(39%) sepia(97%) saturate(2816%) hue-rotate(204deg) brightness(100%) contrast(104%);
}

.session-body {
  flex: 1;
  min-width: 0;
  padding-top: 2rpx;
}

.session-title-row {
  display: flex;
  align-items: center;
  min-width: 0;
}

.session-title {
  color: #1a1a1a;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.25;
}

.session-meta {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  min-width: 0;
}

.kb-tag {
  max-width: 160rpx;
  padding: 3rpx 12rpx;
  border-radius: 6rpx;
  background: #f5f5f5;
  color: #888888;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.25;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 0 1 auto;
}

.message-count {
  margin-left: 14rpx;
  color: #bdbdbd;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.25;
  flex: 0 0 auto;
}

.session-preview {
  margin-top: 12rpx;
  color: #888888;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.35;
}

.session-side {
  width: 96rpx;
  margin-left: 18rpx;
  display: flex;
  align-items: flex-start;
  justify-content: flex-end;
  gap: 14rpx;
  flex: 0 0 96rpx;
}

.session-time {
  color: #bdbdbd;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.25;
}

.session-arrow {
  color: #bdbdbd;
  font-size: 36rpx;
  line-height: 1;
}

.empty {
  padding: 80rpx 24rpx;
  background: #ffffff;
  text-align: center;
}

.empty-icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 20rpx;
  filter: brightness(0);
  opacity: 0.16;
}

.empty-title {
  color: #1a1a1a;
  font-size: 30rpx;
  font-weight: 700;
}

.empty-desc {
  margin-top: 10rpx;
  color: #888888;
  font-size: 26rpx;
}
