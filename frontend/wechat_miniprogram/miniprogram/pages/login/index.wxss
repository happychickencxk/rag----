.login-page {
  min-height: 100vh;
  background: #f7f8fa;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 48rpx;
}

.login-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
}

.login-logo {
  width: 144rpx;
  height: 144rpx;
  border-radius: 36rpx;
  background: #1677ff;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(22, 119, 255, 0.24);
}

.login-logo-image {
  width: 80rpx;
  height: 80rpx;
}

.login-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 12rpx;
}

.login-desc {
  font-size: 26rpx;
  color: #888888;
  margin-bottom: 64rpx;
}

.login-status {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 32rpx;
  color: #888888;
  font-size: 26rpx;
}

.login-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #e8e8e8;
  border-top-color: #1677ff;
  border-radius: 24rpx;
  margin-bottom: 16rpx;
  animation: login-spin 800ms linear infinite;
}

@keyframes login-spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.login-error {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  padding: 16rpx 24rpx;
  background: #fff2f0;
  border-radius: 12rpx;
  border: 1rpx solid #ffccc7;
  color: #ef4444;
  font-size: 26rpx;
}

.login-error-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.login-btn {
  width: 100%;
  height: 96rpx;
  background: #1677ff;
  color: #ffffff;
  border-radius: 18rpx;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: opacity 200ms ease;
}

.login-btn:active {
  opacity: 0.8;
}

.login-hint {
  margin-top: 32rpx;
  text-align: center;
  color: #bdbdbd;
  font-size: 24rpx;
  line-height: 1.6;
}

.login-hint-sub {
  display: block;
  font-size: 22rpx;
  color: #d0d0d0;
}

.login-footer {
  position: absolute;
  bottom: 80rpx;
  color: #bdbdbd;
  font-size: 22rpx;
}
