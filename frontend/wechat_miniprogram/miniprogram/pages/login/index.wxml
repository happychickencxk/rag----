<custom-nav title="企业知识库助手" />

<view class="page login-page">
  <view class="login-card">
    <view class="login-logo">
      <image class="login-logo-image" src="/images/icons/ai-assistant.png" mode="aspectFit" />
    </view>
    <view class="login-title">企业知识库助手</view>
    <view class="login-desc">基于 AI 的企业内部知识检索与问答</view>

    <button
      class="login-btn"
      bindtap="handleLogin"
      aria-label="进入体验"
    >
      <text>{{loading ? '正在进入...' : '进入体验'}}</text>
    </button>

    <view class="login-hint">
      <text>当前为体验版本，暂不校验微信登录</text>
      <text class="login-hint-sub">后续将接入微信一键登录接口</text>
    </view>
  </view>

  <view class="login-footer">
    <text>登录即表示同意服务条款和隐私政策</text>
  </view>
</view>
