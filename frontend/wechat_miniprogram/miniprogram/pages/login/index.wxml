<custom-nav title="企业知识库助手" />

<view class="page login-page">
  <view class="login-card">
    <view class="login-logo">
      <image class="login-logo-image" src="/images/icons/ai-assistant.png" mode="aspectFit" />
    </view>
    <view class="login-title">企业知识库助手</view>
    <view class="login-desc">基于 AI 的企业内部知识检索与问答</view>

    <view wx:if="{{status === 'error'}}" class="login-error">
      <text>{{errorMsg}}</text>
    </view>

    <button
      class="login-btn"
      bindtap="handleLogin"
      loading="{{status === 'loading'}}"
      disabled="{{status === 'loading'}}"
      aria-label="微信一键登录"
    >
      <text>{{status === 'loading' ? '正在登录...' : '微信一键登录'}}</text>
    </button>

    <view class="login-hint">
      <text>当前连接本地 RAG 后端进行接口验收</text>
      <text class="login-hint-sub">开发者工具无法获取 code 时使用固定开发身份</text>
    </view>
  </view>

  <view class="login-footer">
    <text>登录即表示同意服务条款和隐私政策</text>
  </view>
</view>
